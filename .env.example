# ==============================================================================
# PDFtrack Deployment - Environment Variables Configuration Template
# ==============================================================================
# Adheres to Twelve-Factor App (Factor III - Store config in the environment).
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# === IMÁGENES (producción) ===
EXTRACTOR_IMAGE=pdftrack-extractor:latest
DOCUMENTS_IMAGE=pdftrack-documents:latest
PROXY_IMAGE=pdftrack-proxy:latest

# === PATHS LOCALES (solo para docker-compose.build.yml) ===
EXTRACTOR_PATH=../pdftrack-extractor
DOCUMENTS_PATH=../pdftrack-documents
PROXY_PATH=../pdftrack-proxy

# === PROXY (Traefik v3) ===
PUBLIC_PORT=80
INTERNAL_PING_PORT=8082
EXTRACTOR_HOST=extractor
EXTRACTOR_PORT=8000
DOCUMENTS_HOST=documents
DOCUMENTS_PORT=8001
MAX_REQUEST_BODY_BYTES=57671680
MEM_REQUEST_BODY_BYTES=2097152
PROXY_READ_TIMEOUT=35s
PROXY_CONNECT_TIMEOUT=5s
PROXY_SEND_TIMEOUT=35s
PROXY_GRACE_TIMEOUT=30s
TRAEFIK_LOG_LEVEL=WARN

# === EXTRACTOR ===
PORT=8000
EXTRACTION_WORKERS=1
EXTRACTION_QUEUE_SIZE=1
QUEUE_WAIT_TIMEOUT_SECONDS=0
EXTRACTION_TIMEOUT_SECONDS=30
MAX_PDF_SIZE_MB=50

# === DOCUMENTS ===
DOCUMENTS_PORT=8001
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=pdftrack
MONGODB_COLLECTION_NAME=documents
MAX_PDF_SIZE_MB=50
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# === MONGODB ===
MONGO_INITDB_DATABASE=pdftrack

# === LOGS ===
LOG_LEVEL=INFO
